<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: the app cannot connect anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Asked only when the user taps "Show me" for that category. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Only for the optional re-scan reminder, a notification scheduled on this device. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager adds a foreground service the reminder never uses: removed, so no FGS declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Package visibility: only the named sensitive apps (catalogue/Sensitive.kt) and the
         intents any app may ask about. No broad "all apps" visibility. -->
    <queries>
        <!-- So the system's own Settings can be found and opened directly. -->
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <package android:name="com.grindrapp.android" />
        <package android:name="com.tinder" />
        <package android:name="com.bumble.app" />
        <package android:name="co.hinge.app" />
        <package android:name="com.soft.blued" />
        <package android:name="com.okcupid.okcupid" />
        <package android:name="com.bitsmedia.android.muslimpro" />
        <package android:name="com.sirma.mobile.bible.android" />
        <package android:name="app.hallow.android" />
        <package android:name="org.iggymedia.periodtracker" />
        <package android:name="com.clue.android" />
        <package android:name="com.talkspace.talkspaceapp" />
        <package android:name="com.getsomeheadspace.android" />
        <package android:name="com.calm.android" />
        <package android:name="com.betterhelp" />
        <package android:name="com.thehappyhealthinc.iamsober" />
        <package android:name="com.weightloss.quitzilla" />
        <package android:name="com.psiphon3" />
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.android" />
        <package android:name="ch.protonvpn.android" />
        <package android:name="com.nordvpn.android" />
        <package android:name="net.mullvad.mullvadvpn" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="org.telegram.messenger" />
        <package android:name="ch.threema.app" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.viber.voip" />
        <package android:name="com.binance.dev" />
        <package android:name="com.coinbase.android" />
        <package android:name="io.metamask" />
        <package android:name="com.bet365Wrapper.Bet365_Application" />
        <package android:name="com.teamblind.blind" />
        <package android:name="com.glassdoor.app" />
        <package android:name="com.foxnews.android" />
        <package android:name="com.cnn.mobile.android.phone" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <!-- Who can watch you: built-in apps that hold notification access on stock devices, named
             so the app can confirm they're part of the system (FLAG_SYSTEM) instead of trusting
             a package name, plus the home screen app. Narrow, named queries only. -->
        <package android:name="com.google.android.as" />
        <package android:name="com.google.android.apps.nexuslauncher" />
        <package android:name="com.sec.android.app.launcher" />
        <package android:name="com.samsung.android.app.aodservice" />
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Nothing is backed up: scan history stays on the device. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FootprintInspector">
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.ScoreWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/score_widget_info" />
        </receiver>
    </application>
</manifest>
