<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="74dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/mascot_cutout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/WidgetLabel" android:text="@string/widget_label" android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_not_checked_lines"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_checked"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"
                android:textColor="@color/widget_ink"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView style="@style/WidgetNote" android:text="@string/widget_out_of" />

            <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView style="@style/WidgetNote" android:text="@string/widget_last_check" />

            <TextView
                android:id="@+id/widget_date"
                style="@style/WidgetNote"
                android:textColor="@color/widget_ink"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
