<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="124dp"
        android:layout_height="128dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot_cutout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/WidgetNote"
            android:text="@string/app_name"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />

        <TextView
            style="@style/WidgetLabel"
            android:layout_marginTop="8dp"
            android:text="@string/widget_label"
            android:textColor="@color/widget_muted" />

        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/widget_not_checked"
                android:textColor="@color/widget_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView style="@style/WidgetNote" android:text="@string/widget_open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_checked"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_ink"
                    android:textSize="52sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/WidgetNote"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/widget_out_of" />
            </LinearLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/WidgetNote" android:text="@string/widget_last_check" />

                <TextView
                    android:id="@+id/widget_date"
                    style="@style/WidgetNote"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
