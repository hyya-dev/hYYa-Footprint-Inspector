<?xml version="1.0" encoding="utf-8"?>
<!-- The Quiet Noir ground with its soft sand glow, as on the store slides. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/widget_base" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0" android:gradientRadius="130dp"
                android:startColor="@color/widget_glow_top" android:endColor="#00000000" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.8" android:centerY="1" android:gradientRadius="110dp"
                android:startColor="@color/widget_glow_bottom" android:endColor="#00000000" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/widget_rule" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
</layer-list>
