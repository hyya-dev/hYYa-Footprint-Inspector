<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store apps must be sandboxed. Nothing else is granted yet: no network client,
	     no file access. Each permission is added only when a reader needs it. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
