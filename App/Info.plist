<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged with the build-generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
  Every permission is requested only when the user taps "Show me" for that category, never at launch.
  No microphone, Health, HomeKit or tracking keys: we don't use them.
-->
<plist version="1.0">
<dict>
	<!-- Export compliance: only Apple's hashing (CryptoKit SHA-256) is used; no encryption of user data in transit. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMotionUsageDescription</key>
	<string>To show you what any app with Motion &amp; Fitness access can learn, such as your steps and whether you walk or drive. It stays on this device.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>To show you what any app with location access can see about where you are. It stays on this device.</string>
	<key>NSCameraUsageDescription</key>
	<string>To show you what any app with camera access can learn about your cameras. No photo or video is taken.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>To show you which nearby devices any app with Bluetooth access can see, often with their owners' names. It stays on this device.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>To show you which devices on your Wi-Fi any app with Local Network access can see. It stays on this device.</string>
	<key>NSContactsUsageDescription</key>
	<string>To show you what any app with Contacts access can learn. We only count; nothing is saved or sent.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To show you what any app with Photos access can learn, such as the places your photos were taken. It stays on this device.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>To show you what any app with Calendar access can learn. We only count; nothing is saved or sent.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>To show you what any app with Reminders access can learn. We only count; nothing is saved or sent.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>To show you what any app with Media &amp; Apple Music access can learn about your taste. It stays on this device.</string>
